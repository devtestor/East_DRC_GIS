# Eastern DRC Land GIS staging environment contract.
# Copy into an environment-specific secret store. Do not commit real values.

API_PORT=8080
DB_HOST=postgres.internal.example
DB_PORT=5432
DB_NAME=edrc_land_gis
DB_USER=edrc_app
DB_PASSWORD=__SET_IN_SECRET_MANAGER__
DEV_SEED_ENABLED=false
CORS_ALLOWED_ORIGINS=https://staff.staging.example,https://citizen.staging.example
AUDIT_TRUSTED_PROXY_CIDRS=10.0.0.0/8
MAX_FILE_SIZE=15MB
MAX_REQUEST_SIZE=20MB
MAX_HTTP_REQUEST_HEADER_SIZE=16KB
FORWARD_HEADERS_STRATEGY=framework
